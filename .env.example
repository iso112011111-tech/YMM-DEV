# Discord OAuth2 & Bot Tokens
DISCORD_CLIENT_ID=1546488470355054642
DISCORD_CLIENT_SECRET=replace-with-a-new-client-secret
DISCORD_REDIRECT_URI=https://ymm-dev.vercel.app/api/auth/discord/callback
SESSION_SECRET=replace-with-a-long-random-string
DISCORD_ROLE_BOT_TOKEN=replace-with-discord-role-bot-token
DISCORD_TICKET_BOT_TOKEN=replace-with-discord-ticket-bot-token
DISCORD_BOT_TOKEN=legacy-fallback-token

# Ticket Bot Firebase (botticket-8b709)
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"botticket-8b709",...}

# Role Bot Firebase (botdiscord-role)
FIREBASE_SERVICE_ACCOUNT_KEY_ROLE={"type":"service_account","project_id":"botdiscord-role",...}

# Alternative Firebase Credentials (หากไม่ใช้ JSON ก้อนเดียว)
FIREBASE_PROJECT_ID=botticket-8b709
FIREBASE_CLIENT_EMAIL=your-service-account@project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# AES-256-GCM Encryption Key for BYOK API Keys (32 bytes = 64 hex chars)
ENCRYPTION_KEY=your_64_hex_chars_master_key_here_generate_with_openssl_rand_hex_32

